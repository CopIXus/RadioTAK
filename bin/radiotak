#!/usr/bin/env bash
# RadioTAK operator CLI
set -euo pipefail

INSTALL_DIR="${RADIOTAK_INSTALL_DIR:-/opt/radiotak}"
DATA_DIR="${RADIOTAK_DATA_DIR:-/var/lib/radiotak}"
SERVICE="radiotak"

usage() {
  cat <<EOF
Usage: radiotak <command>

  start | stop | restart | status
  logs [--follow]
  update [branch]
  reset-password
  replay <file.jsonl>
  diagnostics
  help
EOF
}

cmd=${1:-help}
shift || true

case "$cmd" in
  start) systemctl start "$SERVICE" ;;
  stop) systemctl stop "$SERVICE" ;;
  restart) systemctl restart "$SERVICE" ;;
  status) systemctl status "$SERVICE" --no-pager ;;
  logs)
    if [[ "${1:-}" == "--follow" || "${1:-}" == "-f" ]]; then
      journalctl -u "$SERVICE" -f
    else
      journalctl -u "$SERVICE" -n 200 --no-pager
    fi
    ;;
  update)
    BRANCH="${1:-main}"
    # Always fetch as the service user so UI updates are not blocked by root-owned
    # objects left behind from a previous `sudo git` / installer run.
    if [[ $EUID -eq 0 ]]; then
      PRIV=""
      [[ -x "$INSTALL_DIR/bin/radiotak-priv" ]] && PRIV="$INSTALL_DIR/bin/radiotak-priv"
      [[ -z "$PRIV" && -x /usr/local/sbin/radiotak-priv ]] && PRIV=/usr/local/sbin/radiotak-priv
      if [[ -n "$PRIV" ]]; then
        "$PRIV" git-update "$BRANCH" CopIXus/RadioTAK || {
          echo "Privilege helper git-update unavailable; fetching as service user"
          chown -R radiotak:radiotak "$INSTALL_DIR" 2>/dev/null || true
          sudo -u radiotak git -c "safe.directory=$INSTALL_DIR" -C "$INSTALL_DIR" fetch https://github.com/CopIXus/RadioTAK.git "$BRANCH"
          sudo -u radiotak git -c "safe.directory=$INSTALL_DIR" -C "$INSTALL_DIR" checkout --force -B "$BRANCH" FETCH_HEAD
          chown -R radiotak:radiotak "$INSTALL_DIR" 2>/dev/null || true
        }
      else
        echo "Privilege helper git-update unavailable; fetching as service user"
        chown -R radiotak:radiotak "$INSTALL_DIR" 2>/dev/null || true
        sudo -u radiotak git -c "safe.directory=$INSTALL_DIR" -C "$INSTALL_DIR" fetch https://github.com/CopIXus/RadioTAK.git "$BRANCH"
        sudo -u radiotak git -c "safe.directory=$INSTALL_DIR" -C "$INSTALL_DIR" checkout --force -B "$BRANCH" FETCH_HEAD
        chown -R radiotak:radiotak "$INSTALL_DIR" 2>/dev/null || true
      fi
    else
      git -c "safe.directory=$INSTALL_DIR" -C "$INSTALL_DIR" fetch https://github.com/CopIXus/RadioTAK.git "$BRANCH"
      git -c "safe.directory=$INSTALL_DIR" -C "$INSTALL_DIR" checkout --force -B "$BRANCH" FETCH_HEAD
    fi
    if [[ -x "$INSTALL_DIR/.venv/bin/pip" ]]; then
      "$INSTALL_DIR/.venv/bin/pip" install -r requirements.txt -q
      "$INSTALL_DIR/.venv/bin/pip" install -e "$INSTALL_DIR" -q
    fi
    if [[ $EUID -eq 0 ]]; then
      install -m 0755 "$INSTALL_DIR/bin/radiotak-priv" /usr/local/sbin/radiotak-priv 2>/dev/null || true
      install -m 0755 "$INSTALL_DIR/bin/radiotak" /usr/local/bin/radiotak 2>/dev/null || true
      chown -R radiotak:radiotak "$INSTALL_DIR" 2>/dev/null || true
    fi
    systemctl restart "$SERVICE"
    echo "Updated to $(cat "$INSTALL_DIR/VERSION" 2>/dev/null || echo unknown) ($BRANCH)"
    ;;
  reset-password)
    [[ $EUID -eq 0 ]] || { echo "Run as root"; exit 1; }
    if [[ -n "${RADIOTAK_ADMIN_PASSWORD:-}" ]]; then
      USER="${RADIOTAK_ADMIN_USER:-admin}"
      PASS="$RADIOTAK_ADMIN_PASSWORD"
    elif (exec <>/dev/tty) 2>/dev/null; then
      read -r -p "Username [admin]: " USER < /dev/tty || true
      USER=${USER:-admin}
      read -r -s -p "New password: " PASS < /dev/tty || { echo "No password entered"; exit 1; }
      echo
      read -r -s -p "Confirm: " PASS2 < /dev/tty || { echo "No password entered"; exit 1; }
      echo
      [[ "$PASS" == "$PASS2" ]] || { echo "Mismatch"; exit 1; }
    else
      echo "Need a terminal, or set RADIOTAK_ADMIN_USER / RADIOTAK_ADMIN_PASSWORD"
      exit 1
    fi
    [[ ${#PASS} -ge 8 ]] || { echo "Use at least 8 characters"; exit 1; }
    # Write via Python so Argon2 hashes (which contain '$') are never expanded by bash.
    RADIOTAK_DATA_DIR="$DATA_DIR" "$INSTALL_DIR/.venv/bin/python3" -c \
      'import sys; from radiotak.auth import save_auth; save_auth(sys.argv[1], sys.argv[2])' \
      "$USER" "$PASS"
    unset PASS PASS2 RADIOTAK_ADMIN_PASSWORD
    chown radiotak:radiotak "$DATA_DIR/auth.json" 2>/dev/null || true
    systemctl restart "$SERVICE"
    echo "Password updated"
    ;;
  replay)
    FILE=${1:-}
    [[ -n "$FILE" ]] || { echo "Usage: radiotak replay <file.jsonl>"; exit 1; }
    export RADIOTAK_DATA_DIR="$DATA_DIR"
    export RADIOTAK_INSTALL_DIR="$INSTALL_DIR"
    "$INSTALL_DIR/.venv/bin/python" -m radiotak.cli_replay "$FILE"
    ;;
  diagnostics)
    export RADIOTAK_DATA_DIR="$DATA_DIR"
    export RADIOTAK_INSTALL_DIR="$INSTALL_DIR"
    OUT="/tmp/radiotak-diagnostics-$(date +%Y%m%d%H%M%S).zip"
    "$INSTALL_DIR/.venv/bin/python" -c "
from radiotak.services.diagnostics import build_diagnostics_zip
from pathlib import Path
Path('$OUT').write_bytes(build_diagnostics_zip())
print('$OUT')
"
    ;;
  help|--help|-h) usage ;;
  *) usage; exit 1 ;;
esac
