{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CopIXus/RadioTAK/integrations/sdrtrunk/event-schema.json",
  "title": "sdr2tak.location.v1",
  "type": "object",
  "required": ["schema", "decoder", "radio_id", "latitude", "longitude", "observed_at"],
  "properties": {
    "schema": { "const": "sdr2tak.location.v1" },
    "event_id": { "type": "string" },
    "decoder": { "type": "string" },
    "protocol": { "type": "string" },
    "system_name": { "type": ["string", "null"] },
    "system_id": { "type": ["string", "null"] },
    "site_id": { "type": ["string", "null"] },
    "nac": { "type": ["string", "null"] },
    "frequency_hz": { "type": ["integer", "null"] },
    "talkgroup": { "type": ["string", "null"] },
    "radio_id": { "type": "string" },
    "source_alias": { "type": ["string", "null"] },
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "altitude_m": { "type": ["number", "null"] },
    "speed_mps": { "type": ["number", "null"] },
    "heading_deg": { "type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360 },
    "accuracy_m": { "type": ["number", "null"] },
    "emergency": { "type": "boolean" },
    "rssi_dbm": { "type": ["number", "null"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "raw_event_type": { "type": ["string", "null"] }
  }
}
