{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CopIXus/RadioTAK/integrations/sdrtrunk/decode-event-schema.json",
  "title": "sdr2tak.decode.v1",
  "type": "object",
  "required": ["schema", "radio_id", "observed_at"],
  "properties": {
    "schema": { "const": "sdr2tak.decode.v1" },
    "event_id": { "type": "string" },
    "decoder": { "type": "string" },
    "protocol": { "type": ["string", "null"] },
    "p25_phase": { "type": ["string", "null"] },
    "system_name": { "type": ["string", "null"] },
    "system_id": { "type": ["string", "null"] },
    "wacn": { "type": ["string", "null"] },
    "nac": { "type": ["string", "null"] },
    "rfss": { "type": ["string", "null"] },
    "site_id": { "type": ["string", "null"] },
    "frequency_hz": { "type": ["integer", "null"] },
    "channel": { "type": ["string", "null"] },
    "timeslot": { "type": ["integer", "null"] },
    "talkgroup": { "type": ["string", "null"] },
    "radio_id": { "type": "string" },
    "source_alias": { "type": ["string", "null"] },
    "destination_radio_id": { "type": ["string", "null"] },
    "encrypted": { "type": "boolean" },
    "algorithm_id": { "type": ["integer", "string", "null"] },
    "algorithm_id_hex": { "type": ["string", "null"] },
    "key_id": { "type": ["integer", "string", "null"] },
    "message_indicator": { "type": ["string", "null"] },
    "message_indicator_hex": { "type": ["string", "null"] },
    "duration_ms": { "type": ["integer", "null"] },
    "key_loaded": { "type": "boolean" },
    "emergency": { "type": "boolean" },
    "observed_at": { "type": "string", "format": "date-time" },
    "raw_event_type": { "type": ["string", "null"] },
    "details": { "type": ["string", "null"] }
  }
}
